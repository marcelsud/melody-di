{
  "name": "@marcelsud/melodi",
  "version": "0.1.5",
  "description": "MeloDI: a small dependency injection container for JavaScript and TypeScript",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "jest",
    "build": "tsc",
    "prepack": "npm run build",
    "check": "npm run build && jest --runInBand && node scripts/verify-package.cjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelsud/melody-di.git"
  },
  "keywords": [
    "dependency",
    "injection"
  ],
  "author": "Marcelo Santos @marcelsud",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/marcelsud/melody-di/issues"
  },
  "homepage": "https://github.com/marcelsud/melody-di#readme",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  }
}
